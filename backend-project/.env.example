# ============================================
# Stock Research Lab - Local Backend Config
# ============================================

# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=7001
FRONTEND_ORIGIN=http://localhost:5173

# ============================================
# PostgreSQL - Local Docker
# ============================================
DATABASE_URL="postgresql://stock_research_user:CHANGE_ME@127.0.0.1:5437/stock_research_lab?schema=public"

# ============================================
# Market Data Providers
# ============================================

# Primary: Tiingo (Historical EOD OHLCV)
TIINGO_API_KEY=

# Fallback: Twelve Data
TWELVE_DATA_API_KEY=

# Provider Selection
PRIMARY_MARKET_DATA_PROVIDER=tiingo
FALLBACK_MARKET_DATA_PROVIDER=twelve_data

# ============================================
# OpenAI - Investment Research
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# ============================================
# SEC EDGAR - Company Filings
# ============================================

# No API key required
# Replace with a valid contact email
SEC_EDGAR_USER_AGENT="StockResearchLab/0.1 contact@example.com"

# Conservative request rate limit
SEC_EDGAR_MAX_RPS=2