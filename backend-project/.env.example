# ============================================
# Stock Research Lab - Local Backend Config (copy to .env if it does not exist)
# ============================================

# Application
NODE_ENV=development
# Only 127.0.0.1 is accepted; never expose the API to the network.
HOST=127.0.0.1
PORT=7001
# Exact local HTTP origin, no trailing slash. Match the frontend URL you use.
FRONTEND_ORIGIN=http://localhost:5173

# ============================================
# PostgreSQL - Local Docker
# ============================================
# Required for readiness and persistence; liveness still works when blank.
# After inspecting Docker/ports, run: node scripts/configure-database.mjs 5437
# The setup command fills a blank URL with a random password and creates the
# ignored .env.postgres used by root compose.yaml. Existing URLs are preserved.
# Selected local port: 5437. Recheck availability on another computer.
DATABASE_URL=

# ============================================
# Tiingo - Sole Market-Price Provider
# ============================================

# Historical daily EOD OHLCV
TIINGO_API_KEY=
# Verified Starter defaults (2026-10-12). Other apps using this key also consume
# account quota; lower these budgets to reserve headroom. Raise only for a
# verified account plan. Local enforcement uses conservative rolling windows.
TIINGO_MAX_REQUESTS_PER_HOUR=50
TIINGO_MAX_REQUESTS_PER_DAY=1000
TIINGO_MAX_SYMBOLS_PER_MONTH=500
TIINGO_MAX_BYTES_PER_MONTH=1000000000

# ============================================
# SEC EDGAR - Company Filings
# ============================================

# No API key required
# Optional for startup/cached reads. SEC synchronization needs your real contact:
# Supply your own application identity and contact email; placeholders are rejected.
SEC_EDGAR_USER_AGENT=

# Conservative integer request rate limit (1-10)
SEC_EDGAR_MAX_RPS=2

# ============================================
# OpenAI - News and Qualitative Research
# ============================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
