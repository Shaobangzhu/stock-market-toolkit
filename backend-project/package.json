{
  "name": "stock-research-lab-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local-only Stock Research Lab API",
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "npm run db:generate && node scripts/clean.mjs && tsc",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "db:verify": "npm run build && node scripts/verify-database.mjs",
    "test:integration": "npm run build && node scripts/test-database.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "18.0.7",
    "express": "5.3.0",
    "pg": "8.23.1",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "overrides": {
    "mysql2": "3.24.5",
    "@prisma/config": {
      "deepmerge-ts": "8.0.0"
    }
  }
}
